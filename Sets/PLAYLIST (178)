  <notes/>
  <slides>
  <slide>
  <body>“Nikdo nemůže plně poznat Boha, i když ho může hledat a zakoušet.”</body></slide></slides></slide_group>
  <slide_group name="Nepojmenovaný" type="custom" print="true" seconds="0" loop="false" transition="0">
